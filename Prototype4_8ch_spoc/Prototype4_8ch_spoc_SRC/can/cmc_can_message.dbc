CM_ BO_ 100 "Startup init to check ID and FW for all units, inititate reset or reconfig if needed";
CM_ SG_ 100 hw_version_major "Hardware major version";
CM_ SG_ 100 hw_version_minor "Hardware minor version";
CM_ SG_ 100 unit_id "Unique ID for the source unit";
CM_ SG_ 100 unit_type "Unit type";
CM_ SG_ 100 fw_version_major "Firmware major version, should listed for compability to ensure units can be combined";
CM_ SG_ 100 fw_version_minor "Firmware minor version, for info only";
CM_ SG_ 100 gc_datetime "All global configs across all units must be the same, datetime is when the config was created/updated, if not the same across units or if missing, the most recent updated config is to be used and passed over to units with old config";
CM_ SG_ 100 gc_hash "All global configs across all units must be the same, this hash represent global config checksum";
CM_ BO_ 101 "Poll on system frequently to identify missing units or mishaps";
CM_ SG_ 101 unit_id "Unique ID for the source unit";
CM_ SG_ 101 system_state "Report system state for taking action if not OK";
CM_ BO_ 202 "Turn horn on/off";
CM_ SG_ 202 horn_on "0=off, 1=on";
CM_ BO_ 203 "Turn direction indicators on/off, send also info for left, righ or both (hazard) and optionally if to be turned of only for front or rear, normally should be both. Separate for turning on indicator only, to be used for startup animation or check that dashboard indicator bulb works";
CM_ SG_ 203 turn_signal_direction "0=left, 1=right, 2=both";
CM_ SG_ 203 turn_signal_on "0=off, 1=on";
CM_ SG_ 203 turn_signal_position "0=front, 1=rear, 2=both";
CM_ SG_ 203 dashboard_only "0=normal operation, 1=only affect dashboard warning indicator";
CM_ BO_ 200 "Control ignition status";
CM_ SG_ 200 ignition_on "0=off, 1=on";
CM_ BO_ 201 "Control starter motor";
CM_ SG_ 201 starter_on "0=off, 1=engaged (on)";
CM_ BO_ 204 "Lights: park, low beam and high beam";
CM_ SG_ 204 park_on "0 = off, 1=on";
CM_ SG_ 204 low_beam_on "0 = off, 1=on";
CM_ SG_ 204 high_beam_on "0 = off, 1=on";
CM_ BO_ 205 "Lights: Brake Light";
CM_ SG_ 205 brake_light_on "0 = off, 1 = on";
CM_ BO_ 206 "Neutral sensor should activate dashboard light";
CM_ SG_ 206 neutral_engaged "0 = off, 1 = on";
CM_ BO_ 207 "Oil Pressure Sensor should activate warning light on dash";
CM_ SG_ 207 oil_pressure_low_detected "0 = normal operation, 1 = low pressure detected";
CM_ BO_ 208 "Per-channel status; sent once per configured channel per second and immediately on status change";
CM_ SG_ 208 channel_number "Output channel number (1-based, matches CHANNEL_OVERVIEW ch01..ch12)";
CM_ SG_ 208 is_on "1 = switch is currently driven on";
CM_ SG_ 208 status "Channel status code (see VAL_ table)";
CM_ SG_ 208 watts "Power consumption in Watts";
CM_ BO_ 209 "Overview of all 12 channel slots sent every 1 s when overview_enabled=1 in config; unused slots are zero; CAN FD frame";
CM_ BO_ 210 "Unit-level telemetry sent every 1 s: supply voltage, MCU die temperature, and total power across all active channels";
CM_ SG_ 210 supply_voltage "Switch supply voltage in V with 0.01 V resolution; default 12.0 V until sensing HW is added";
CM_ SG_ 210 mcu_temp_c "STM32G4 die temperature in degC with 0.1°C resolution; show N/A to user when mcu_temp_out_of_range = 1; note ±4.5°C sensor accuracy (datasheet)";
CM_ SG_ 210 total_watts "Sum of watts across all active output channels";
CM_ SG_ 210 mcu_temp_out_of_range "1 = temperature reading is out of valid range; display N/A instead of mcu_temp_c";
CM_ SG_ 210 vfref "MCU VDDA supply voltage measured via VREFINT; 0.01 V per bit";
CM_ BO_ 211 "Classic-CAN alternative to CHANNEL_OVERVIEW for channels 1-3; sent every 1 s when overview_enabled_01_03=1 in config";
CM_ BO_ 212 "Classic-CAN alternative to CHANNEL_OVERVIEW for channels 4-6; sent every 1 s when overview_enabled_04_06=1 in config";
CM_ BO_ 213 "Classic-CAN alternative to CHANNEL_OVERVIEW for channels 7-9; sent every 1 s when overview_enabled_07_09=1 in config";
CM_ BO_ 214 "Classic-CAN alternative to CHANNEL_OVERVIEW for channels 10-12; sent every 1 s when overview_enabled_10_12=1 in config";
